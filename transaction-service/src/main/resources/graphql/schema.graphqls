type BankTransaction {
    id: ID!
    accountId: ID!
    amount: Float!
    currency: String
    merchantCategory: String
    country: String
    createdAt: String
}

type Query {
    transactions: [BankTransaction!]!
    transaction(id: ID!): BankTransaction
    transactionsByAccount(accountId: ID!): [BankTransaction!]!
}
